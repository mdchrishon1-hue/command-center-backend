from fastapi import FastAPI
from routes import deals, missions, mesh, intelligence, doctrine

app = FastAPI(title="DDLN Command Center Backend")

@app.get("/health")
def health_check():
    return {"status": "ok"}

app.include_router(deals.router, prefix="/deals", tags=["deals"])
app.include_router(missions.router, prefix="/missions", tags=["missions"])
app.include_router(mesh.router, prefix="/mesh", tags=["mesh"])
app.include_router(intelligence.router, prefix="/intelligence", tags=["intelligence"])
app.include_router(doctrine.router, prefix="/doctrine", tags=["doctrine"])